<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Chameleon.lib.Playwright</RootNamespace>
		<AssemblyTitle>Chameleon.lib.Playwright</AssemblyTitle>
		<Description>Chameleon.lib.Playwright for chameleonmode</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>Chameleon.lib.Playwright$(PackageSuffix)</PackageId>
		<Configurations>Debug;Release</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Playwright" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="DynamicData" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Chameleon.lib\Chameleon.lib.csproj" />
	  <ProjectReference Include="..\Chameleon.lib.Api\Chameleon.lib.Api.csproj" />
	  <ProjectReference Include="..\Chameleon.lib.WebBrowser\Chameleon.lib.WebBrowser.csproj" />
	</ItemGroup>

</Project>
