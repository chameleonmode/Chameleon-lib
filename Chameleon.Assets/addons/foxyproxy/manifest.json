{
  "name": "Foxy Proxy",
  "description": "Because a proxy is foxy",
  "version": "2025.3.26",
  "manifest_version": 2,
  "permissions": [
    "management",
    "proxy",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestAuthProvider",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "persistent": true,
    "scripts": [ "background.js" ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxyproxy@chameleonmode.com",
      "strict_min_version": "109.0"
    }
  }
}
