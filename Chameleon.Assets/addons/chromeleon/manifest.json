{
  "name": "Chromeleon",
  "description": "A Chromeleon is the extension that can change its behavior to blend into the environment of any websites fishing attempts.",
  "version": "2025.3.16",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/web/register.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "data/popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "geolocation",
    "notifications",
    "privacy",
    "scripting",
    "storage",
    "tabs",
    "userScripts",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [ 
    "<all_urls>"
  ],
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "64": "data/icons/icon_32x32_2x.png",
    "128": "data/icons/icon_128x128.png"
  },
  "key": ""
}