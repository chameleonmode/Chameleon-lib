{
  "name": "Chromeleon",
  "description": "A Chromeleon is the extension that can change its behavior to blend into the environment of any websites fishing attempts.",
  "version": "2025.3.11",
  "manifest_version": 3,
  "offline_enabled": true,
  "incognito": "spanning",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "debugger",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "privacy",
    "scripting",
    "userScripts",
    "tabs",
    "webNavigation",
    "webRequest",
    "geolocation"
  ],
  "host_permissions": [ "<all_urls>" ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "64": "data/icons/icon_32x32_2x.png",
    "128": "data/icons/icon_128x128.png"
  },
  "action": {
    "default_popup": "data/popup/popup.html"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "<all_urls>" ],
      "include_globs": ["<all_urls>"],
      "js": [ "data/scripts/isolated.js" ],
      "world": "ISOLATED"
    },
    {
      "matches": [ "<all_urls>" ],
      "js": [ "data/scripts/content-script.js" ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/web/register.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "key": ""
}
