{
  "name": "Chromeleon",
  "description": "A Chromeleon can change its behavior to blend into the environment of any website troller.",
  "version": "2025.7.27",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "bookmarks",
    "debugger",
    "declarativeNetRequest",
    "geolocation",
    "management",
    "privacy",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [ 
    "<all_urls>"
  ],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "data/popup/popup.html"
  },
  "icons": {
    "16": "data/icons/16x16.png",
    "32": "data/icons/16x16_2x.png",
    "64": "data/icons/32x32_2x.png",
    "128": "data/icons/128x128.png"
  },
  "key": ""
}