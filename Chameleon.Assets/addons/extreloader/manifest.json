{
  "name": "Chromeleon Extension Reloader",
  "version": "2024.1.8.0",
  "description": "Reloads all packaged extensions.",
  "permissions": [
    "storage",
    "tabs",
    "management"
  ],
  "host_permissions": [ "<all_urls>" ],
  "background": {
    "service_worker": "background.js"
  },
  "manifest_version": 3
}