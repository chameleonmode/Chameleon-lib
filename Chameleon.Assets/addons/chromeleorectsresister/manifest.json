{
  "manifest_version": 3,
  "name": "Client Rects Fingerprint Resistance",
  "version": "1.0",
  "permissions": [ "storage", "scripting" ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "match_origin_as_fallback": true,
      "js": [ "content.js" ]

    }
  ]
}