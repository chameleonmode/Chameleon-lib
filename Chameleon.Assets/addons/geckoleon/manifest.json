{
  "name": "Geckoleon",
  "description": "A Geckoleon can change its behavior to blend into the environment of any website troller.",
  "version": "2025.7.15",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "bookmarks",
    "declarativeNetRequest",
    "geolocation",
    "proxy",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],
  "background": {
    "type": "module",
    "scripts": [ "background.js" ]
  },
  "action": {
    "default_popup": "data/popup/popup.html"
  },
  "icons": {
    "16": "data/icons/16x16.png",
    "32": "data/icons/16x16_2x.png",
    "64": "data/icons/32x32_2x.png",
    "128": "data/icons/128x128.png"
  },
  "content_security_policy": {
    "extension_pages": "style-src 'self' 'unsafe-inline'; script-src 'self'"

  },
  "browser_specific_settings": {
    "gecko": {
      "id": "geckoleon@com.chameleon.mode",
      "strict_min_version": "128.0"
    }
  }
}