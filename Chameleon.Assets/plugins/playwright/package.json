{
  "name": "chameleon-playwright",
  "version": "1.0.0",
  "description": "Dynamic Playwright test runner",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/app.ts",
    "lunch": "node --loader ts-node/esm tests/examples/launcher.ts",
    "build": "tsc",
    "build:clean": "rm -rf dist",
    "build:prod": "npm run build:clean && tsc -p tsconfig.prod.json && npm run build:prepare",
    "build:dist": "npm run build:prod && cp -r dist/ /Users/dev/src/Chameleon-lib/Chameleon.Assets/plugins/playwright/",
    "build:prepare": "cp package.json dist && cd dist && npm install --omit=dev --no-package-lock --no-bin-links",
    "build:bundle": "esbuild src/app.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/bundle.js --external:@playwright/* --external:playwright* --external:chromium-bidi/* --external:*.node",
    "reddit:repl": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/post/addons/reply",
    "reddit:comm": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/post/addons/comment",
    "reddit:vote": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/subreddit/addons/vote",
    "reddit:post": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/subreddit/addons/post",
    "reddit:join": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/subreddit/addons/join",
    "reddit:foll": "node --loader ts-node/esm src/app.ts ../scripts/reddit/plugins/user/addons/follow",
    "any:record": "node --loader ts-node/esm src/app.ts ../scripts/any/record",
    "scripts:download": "node .scripts/downode.cjs",
    "examples:ask:prompt": "node --loader ts-node/esm tests/examples/ask-prompt.ts",
    "examples:ask:genorate": "node --loader ts-node/esm tests/examples/ask-genorate.ts",
    "examples:ask:robot": "node --loader ts-node/esm tests/examples/ask-robot.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "tar": "^7.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2",
    "unzipper": "^0.12.3"
  }
}
