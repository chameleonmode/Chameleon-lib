<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>chameleon.assets</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="addons\**" />
		<EmbeddedResource Include="js\**" />
		<EmbeddedResource Include="plugins\**" />
	</ItemGroup>

  <Target Name="GenerateResourceMapping" BeforeTargets="PrepareForBuild">
  <ItemGroup>
    <ResourceFiles Include="plugins\**" />
  </ItemGroup>

  <PropertyGroup>
    <MappingFile>$(IntermediateOutputPath)resource-mapping.json</MappingFile>
  </PropertyGroup>

  <!-- Create individual JSON entries -->
  <ItemGroup>
    <ResourceEntries Include="@(ResourceFiles)">
      <JsonEntry>{ &quot;OriginalPath&quot;: &quot;%(Identity)&quot;, &quot;ResourceName&quot;: &quot;%(RelativeDir)%(Filename)%(Extension)&quot; }</JsonEntry>
    </ResourceEntries>
  </ItemGroup>

  <!-- Create the opening of the JSON file -->
  <WriteLinesToFile
    File="$(MappingFile)" 
    Overwrite="true" 
    Lines="{
  &quot;Files&quot;: ["
   />

  <!-- Write each entry with appropriate comma -->
  <PropertyGroup>
    <EntryCount>@(ResourceEntries->Count())</EntryCount>
    <CurrentEntry>0</CurrentEntry>
  </PropertyGroup>

  <ItemGroup>
    <ResourceEntriesWithIndex Include="@(ResourceEntries)">
      <Index>$([MSBuild]::Add($(CurrentEntry), $([MSBuild]::Add(1,0))))</Index>
    </ResourceEntriesWithIndex>
  </ItemGroup>

  <!-- Write each resource entry -->
  <WriteLinesToFile
    Condition="'%(ResourceEntriesWithIndex.Index)' != '$(EntryCount)'"
    File="$(MappingFile)"
    Lines="    %(ResourceEntriesWithIndex.JsonEntry),"
    Overwrite="false" />

  <WriteLinesToFile
    Condition="'%(ResourceEntriesWithIndex.Index)' == '$(EntryCount)'"
    File="$(MappingFile)"
    Lines="    %(ResourceEntriesWithIndex.JsonEntry)"
    Overwrite="false" />

  <!-- Close the JSON file -->
  <WriteLinesToFile
    File="$(MappingFile)"
    Lines="  ]
}"
    Overwrite="false" />

  <ItemGroup>
    <EmbeddedResource Include="$(MappingFile)" LogicalName="$(RootNamespace).resource-mapping.json" />
  </ItemGroup>
</Target>

</Project>
