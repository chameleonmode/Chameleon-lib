<Project>
	<PropertyGroup>
		<TargetDotnetVersion>net8.0</TargetDotnetVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>true</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Version>2024.0.0.3</Version>
		<Authors>ezexe</Authors>
		<Product>Chameleon.lib</Product>
		<Copyright>Copyright © Chameleonmode 2024</Copyright>
		<PackageProjectUrl>https://github.com/chameleonmode/Chameleon.lib</PackageProjectUrl>
		<!--<PackageOutputPath>C:\repos\nuget</PackageOutputPath>-->
		<PackageOutputPath>C:\repos\nuget</PackageOutputPath>
	</PropertyGroup>
</Project>
